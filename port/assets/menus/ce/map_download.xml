<?xml version="1.0" encoding="UTF-8"?>
<!-- The port's multiplayer screens, in the PC version's style (tools/port_settings.py) -->
<menus>
	<widget name="map_download/map_download_screen" width="640" height="480" flags="pass_unhandled_to_focused_child">
		<on event="b back" run="port map download cancel" sound="sound\sfx\ui\back"/>
		<child widget="map_download/dialog"/>
		<child widget="map_download/button_bar" x="194" y="309"/>
	</widget>
	<widget name="map_download/dialog" width="640" height="480" bitmap="bitmaps/semi_transparent_grey">
		<child widget="map_download/text_box" x="192" y="176"/>
		<child widget="map_download/header" x="201" y="180"/>
	</widget>
	<widget name="map_download/header" type="text" width="150" height="20" text="MAP DOWNLOAD" font="ui\large_ui" color="#FF2896FF">
	</widget>
	<widget name="map_download/text_box" type="text" width="280" height="159" bitmap="bitmaps/alert_bkd" font="ui\large_ui" color="#FF2896FF" text_x="9" text_y="36">
		<data input="port map download update"/>
	</widget>
	<widget name="map_download/button_bar" type="column_list" width="256" height="24" flags="pass_unhandled_to_focused_child up_down_tabs_items left_right_tabs_items">
		<child widget="map_download/button_cancel" x="128"/>
		<child widget="map_download/button_accept"/>
	</widget>
	<widget name="map_download/button_accept" type="text" width="128" height="24" bitmap="bitmaps/text_button_background" font="ui\small_ui" color="#FFFFFFFF" align="center" text_y="2" text="DOWNLOAD">
		<on event="a start" run="port map download accept" sound="sound\sfx\ui\forward"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</widget>
	<widget name="map_download/button_cancel" type="text" width="128" height="24" bitmap="bitmaps/text_button_background" font="ui\small_ui" color="#FFFFFFFF" align="center" text_y="2" text="CANCEL">
		<on event="a start" run="port map download cancel" sound="sound\sfx\ui\back"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</widget>
</menus>
